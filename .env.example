# Prefixul API folosit de frontend — trebuie să corespundă cu prefixul din backend.
VITE_API_URL=/api/v1

# Originea backend-ului la care Vite dev proxy redirecționează cererile /api/v1/*.
VITE_API_ORIGIN=http://localhost:8082

# ── AWS Cognito (opțional) ────────────────────────────────────────────────────
# Lăsați goale sau cu REPLACE_ME pentru a dezactiva login-ul cu Google.
# Completați cu valorile reale din AWS Console pentru a activa fluxul PKCE.
VITE_COGNITO_USER_POOL_ID=eu-central-1_REPLACE_ME
VITE_COGNITO_CLIENT_ID=REPLACE_ME
VITE_COGNITO_DOMAIN=your-domain.auth.eu-central-1.amazoncognito.com
VITE_COGNITO_REDIRECT_URI=http://localhost:3000/auth/callback
