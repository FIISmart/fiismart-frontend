# Production env — committed to git, used by Vite at build time on Vercel
# and by any local `vite build` run.
#
# Local dev uses `.env` (gitignored) with VITE_API_URL=/api/v1 + the dev
# proxy in vite.config.ts pointing to localhost:8082.
#
# In prod there is no proxy: the FE calls the BE directly. The Vercel
# project also has this var set in the dashboard so `vercel deploy` works
# even if this file is removed — but committing it here keeps the source
# of truth in-repo for anyone running `vite build` locally or hooking up
# CI later.

VITE_API_URL=https://fiismart-backend-production.up.railway.app/api/v1

# Cognito Hosted UI config — public values, safe to commit.
# VITE_COGNITO_REDIRECT_URI is intentionally NOT set: the FE auto-derives it
# from window.location.origin so previews and custom domains work too.
VITE_COGNITO_USER_POOL_ID=eu-north-1_puAbduwjE
VITE_COGNITO_CLIENT_ID=3vpkkk13bkdcff135og9jl7vp9
VITE_COGNITO_DOMAIN=eu-north-1puabduwje.auth.eu-north-1.amazoncognito.com
